# Copy to dashboard/.env and fill in. dashboard/.env is gitignored - never commit it.
# Placeholders only. Nothing in this file is a real secret.

# production (default) hides API docs; development shows /api/docs
APP_ENV=production

# 127.0.0.1 = only this laptop can reach the backend (fine for the USB serial bridge).
# For the ESP32 over Wi-Fi set HOST=0.0.0.0 and allow the port in the firewall (private network only). Other machines on
# the network then only get the device endpoints (LAN_DEVICE_ONLY); the dashboard and login stay on this laptop.
HOST=127.0.0.1
LAN_DEVICE_ONLY=true
PORT=8000

# Relative paths are resolved from the dashboard/ folder, not from where you start the server.
DATABASE_PATH=data/smartbuddy.db

# Supabase (cloud Postgres). Leave empty to use the SQLite file above.
# Use the Session pooler string from Supabase > Connect. It holds your database password: never commit it.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
MODELS_DIR=ml/models

# Browser origins allowed to call the API (no wildcards). Vite dev server + built app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:8000

# Accounts. Generate hashes with: python scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Optional read-only account
VIEWER_USERNAME=
VIEWER_PASSWORD_HASH=
SESSION_HOURS=8
# Set true only when served over HTTPS
COOKIE_SECURE=false

# Device keys: python scripts/gen_device_key.py sb-esp32-01
# The key itself goes into the firmware's secrets.h (or the serial bridge), only its hash goes here.
# Format: device-id:sha256-of-key[,device-id:sha256-of-key]
DEVICE_KEYS=sb-esp32-01:<sha256-from-gen_device_key>

# Simulator (labelled test data, never counted as real). Off by default.
ALLOW_SIMULATOR=false
SIMULATOR_KEYS=

# Commands expire if the device hasn't picked them up / acked within this time
COMMAND_TTL_S=10
DEVICE_OFFLINE_S=15

# Monitor-only: New_Code.ino switches the fan/LED/buzzer itself and can't receive commands.
# Only set true for firmware that polls /api/v1/device/commands.
DEVICE_CONTROL_ENABLED=false

# Backend gas indication (MQ-2 filtered ADC counts, NOT ppm). Mirrors New_Code.ino:
# MQ2_ALARM_THRESHOLD=420, MQ2_ALARM_HYSTERESIS=100 -> clear at 320 (calibrated, see scripts/mq2_calibrate.py).
GAS_WARNING_ADC=420
GAS_CLEAR_ADC=320

# Backend RULE_BASED thresholds, only used when DEVICE_CONTROL_ENABLED=true (hysteresis: OFF below ON).
# Defaults mirror the firmware rules. Light is the LDR level in % (relative, not lux).
FAN_ON_TEMP_C=26.1
FAN_OFF_TEMP_C=25.5
LIGHT_ON_PCT=30
LIGHT_OFF_PCT=40
MOTION_HOLD_S=300
AUTOMATION_COOLDOWN_S=60

# Leave false until a model has been trained on real feedback and tested.
ENABLE_ML_AUTOMATIC=false
